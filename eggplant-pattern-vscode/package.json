{
  "name": "eggplant-pattern-vscode",
  "displayName": "Eggplant Pattern Preview",
  "description": "Live preview of cursor-scoped eggplant Rust patterns in VSCode.",
  "version": "0.2.2",
  "publisher": "MilkBlock",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.90.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MilkBlock/eggplant_pattern_view_plugin.git"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "activationEvents": [
    "onLanguage:rust",
    "onCommand:eggplant-pattern.preview",
    "onCommand:eggplant-pattern.showPatternDot",
    "onCommand:eggplant-pattern.showActionDot",
    "onCommand:eggplant-pattern.showCombinedDot",
    "onCommand:eggplant-pattern.selectDotView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "eggplant-pattern.preview",
        "title": "Eggplant Pattern: Preview Current Scope"
      },
      {
        "command": "eggplant-pattern.selectDotView",
        "title": "Eggplant Pattern: Select DOT View"
      },
      {
        "command": "eggplant-pattern.showPatternDot",
        "title": "Eggplant Pattern: Show pattern.dot"
      },
      {
        "command": "eggplant-pattern.showActionDot",
        "title": "Eggplant Pattern: Show action.dot"
      },
      {
        "command": "eggplant-pattern.showCombinedDot",
        "title": "Eggplant Pattern: Show action + pattern.dot"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "eggplant-pattern.selectDotView",
          "group": "navigation",
          "when": "resourceLangId == rust"
        }
      ]
    },
    "configuration": {
      "title": "Eggplant Pattern Preview",
      "properties": {
        "eggplantPattern.extractorPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the eggplant-pattern-extractor binary."
        },
        "eggplantPattern.typstPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the Typst CLI executable used for formula rendering in graph nodes."
        },
        "eggplantPattern.autoPreview": {
          "type": "boolean",
          "default": true,
          "description": "Refresh the preview automatically when the cursor or document changes in Rust files."
        },
        "eggplantPattern.debounceMs": {
          "type": "number",
          "default": 200,
          "minimum": 0,
          "description": "Debounce delay before re-running extraction after editor changes."
        },
        "eggplantPattern.defaultDotView": {
          "type": "string",
          "enum": [
            "auto",
            "pattern",
            "action",
            "combined"
          ],
          "default": "auto",
          "description": "Default DOT view mode. 'auto' chooses pattern/action/combined based on the cursor location."
        },
        "eggplantPattern.defaultLabelStyle": {
          "type": "string",
          "enum": [
            "compact",
            "full",
            "recursive"
          ],
          "default": "recursive",
          "description": "Default label style for the built-in graph preview. 'compact' reduces API noise, 'full' preserves raw debugging detail, and 'recursive' expands display templates through the subgraph when possible."
        },
        "eggplantPattern.defaultRecursiveStrategy": {
          "type": "string",
          "enum": [
            "tree-safe",
            "dag-expand"
          ],
          "default": "dag-expand",
          "description": "Recursive rendering strategy. 'tree-safe' only expands tree-shaped display subgraphs, while 'dag-expand' repeats shared subgraphs when rendering recursive labels."
        }
      }
    }
  },
  "scripts": {
    "build:extractor": "cargo build --manifest-path ../eggplant-pattern-extractor/Cargo.toml",
    "bundle:extractor": "node ./scripts/bundle-extractor.js",
    "stage:release-binaries": "node ./scripts/stage-release-binaries.js",
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "package:extension": "npm run build:extractor && npm run bundle:extractor && npm run compile",
    "package:vsix": "npm run package:extension && npx @vscode/vsce package --no-dependencies",
    "package:vsix:prebuilt": "npm run compile && npx @vscode/vsce package --no-dependencies",
    "publish:vsix": "npm run package:vsix && npx @vscode/vsce publish --packagePath *.vsix",
    "pretest": "npm run build:extractor && npm run bundle:extractor && npm run compile",
    "pretest:extension-host": "npm run build:extractor && npm run bundle:extractor && npm run compile",
    "test": "node ./out/test/runHeadless.js",
    "test:extension-host": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "mocha": "^10.8.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@viz-js/viz": "^3.25.0"
  }
}

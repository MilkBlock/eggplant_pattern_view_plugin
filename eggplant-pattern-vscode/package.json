{
  "name": "eggplant-pattern-vscode",
  "displayName": "Eggplant Pattern Preview",
  "description": "Live preview of cursor-scoped eggplant Rust patterns in VSCode.",
  "version": "0.0.1",
  "publisher": "local",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "activationEvents": [
    "onLanguage:rust",
    "onCommand:eggplant-pattern.preview"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "eggplant-pattern.preview",
        "title": "Eggplant Pattern: Preview Current Scope"
      }
    ],
    "configuration": {
      "title": "Eggplant Pattern Preview",
      "properties": {
        "eggplantPattern.extractorPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the eggplant-pattern-extractor binary."
        },
        "eggplantPattern.autoPreview": {
          "type": "boolean",
          "default": true,
          "description": "Refresh the preview automatically when the cursor or document changes in Rust files."
        },
        "eggplantPattern.debounceMs": {
          "type": "number",
          "default": 200,
          "minimum": 0,
          "description": "Debounce delay before re-running extraction after editor changes."
        },
        "eggplantPattern.previewCommand": {
          "type": "string",
          "default": "graphviz-interactive-preview.preview.beside",
          "description": "Command used to display DOT preview content. Override only for testing or custom preview hosts."
        }
      }
    }
  },
  "scripts": {
    "build:extractor": "cargo build --manifest-path ../eggplant-pattern-extractor/Cargo.toml",
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "pretest": "npm run build:extractor && npm run compile",
    "pretest:extension-host": "npm run build:extractor && npm run compile",
    "test": "node ./out/test/runHeadless.js",
    "test:extension-host": "node ./out/test/runTest.js",
    "test:extension-host:graphviz": "node -e \"process.env.EGGPLANT_RUN_GRAPHVIZ_SMOKE_TEST='1'; require('./out/test/runTest.js');\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "mocha": "^10.8.2",
    "typescript": "^5.5.4"
  }
}
